    <!-- Stage 3: Command Safety Classifier -->
    <string name="risk_badge_low">LOW</string>
    <string name="risk_badge_medium">MEDIUM</string>
    <string name="risk_badge_high">HIGH RISK</string>
    <string name="risk_badge_low_bracket">[LOW]</string>
    <string name="risk_badge_medium_bracket">[MED]</string>
    <string name="risk_badge_high_bracket">[HIGH]</string>
    <string name="risk_reason_rm_root">Recursive force-delete (rm -rf) targets root, home, or wildcard paths and can destroy critical files.</string>
    <string name="risk_reason_dd_device">Direct disk write (dd) to a device path can overwrite partitions or corrupt storage.</string>
    <string name="risk_reason_mkfs">Formatting commands (mkfs / wipefs / fdisk) erase filesystems permanently.</string>
    <string name="risk_reason_chmod_777">Recursive chmod 777 grants world-writable permissions across directories.</string>
    <string name="risk_reason_pipe_shell">Piping remote content directly into sh/bash executes unverified scripts immediately.</string>
    <string name="risk_reason_fork_bomb">Fork bomb pattern can exhaust system processes and freeze the device.</string>
    <string name="risk_reason_device_redirect">Redirecting output directly into a raw block or system device can corrupt data.</string>
    <string name="risk_reason_find_delete">find -delete permanently deletes matched files immediately without confirmation.</string>
    <string name="risk_reason_root_perm">Recursive chmod/chown on root (/) alters system-wide permissions or ownership.</string>
    <string name="risk_reason_too_long">Command exceeds 4,000 characters; classified at least MEDIUM risk for manual review.</string>
    <string name="risk_reason_multiline_or_control">Script contains multiple lines or control characters. Confirm to insert into the draft buffer without running.</string>
    <string name="risk_reason_privilege">Runs with elevated root privileges (sudo / su).</string>
    <string name="risk_reason_pkg_remove">Removes or purges installed packages.</string>
    <string name="risk_reason_overwrite">Overwrites target file contents via &gt; redirection.</string>
    <string name="risk_dialog_title">Confirm High-Risk Command Insert</string>
    <string name="risk_dialog_warning">This command is classified as HIGH RISK. Cyberorg only inserts it into the terminal line buffer (it will NOT auto-run), so review carefully before pressing Enter.</string>
