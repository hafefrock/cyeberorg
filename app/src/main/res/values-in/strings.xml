    <string name="risk_reason_rm_root">Penghapusan paksa rekursif (rm -rf) menargetkan root, home, atau wildcard dan dapat merusak berkas penting.</string>
    <string name="risk_reason_dd_device">Penulisan disk langsung (dd) ke perangkat blok dapat menimpa partisi atau merusak penyimpanan.</string>
    <string name="risk_reason_mkfs">Perintah format (mkfs / wipefs / fdisk) menghapus sistem berkas secara permanen.</string>
    <string name="risk_reason_chmod_777">chmod -R 777 memberikan izin tulis terbuka ke semua pengguna di seluruh direktori.</string>
    <string name="risk_reason_pipe_shell">Menyalurkan skrip jarak jauh langsung ke sh/bash mengeksekusi kode tak terverifikasi.</string>
